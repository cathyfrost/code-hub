// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

model User {
  id                     String                @id
  username               String                @unique
  displayName            String
  email                  String?               @unique
  passwordHash           String?
  googleId               String?               @unique
  avatarUrl              String?
  bio                    String?
  skillLevel             Int                   @default(1)
  interests              String[]              @default([])
  points                 Int                   @default(10)
  role                   String                @default("USER") // "USER" | "ADMIN"
  banned                 Boolean               @default(false)
  session                Session[]
  posts                  Post[]
  following              Follow[]              @relation("Following")
  followers              Follow[]              @relation("Followers")
  likes                  Like[]
  bookmarks              Bookmark[]
  comments               Comment[]
  inlineComments         InlineComment[]
  commentLikes           CommentLike[]
  aiConversations        AiConversation[]
  quizSubmissions        QuizSubmission[]
  notebooks              Notebook[]
  notebookFolders        NotebookFolder[]
  receivedNotifications  Notification[]        @relation("Recipient")
  issuedNotifications    Notification[]        @relation("Issuer")
  pointTransactions      PointTransaction[]
  contestRegistrations   ContestRegistration[]
  contestSubmissions     ContestSubmission[]
  challengesAsChallenger Challenge[]           @relation("ChallengerUser")
  challengesAsOpponent   Challenge[]           @relation("OpponentUser")
  challengeSubmissions   ChallengeSubmission[]
  postTags               PostTag[]

  createAt DateTime @default(now())

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String          @id @default(cuid())
  content             String
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         Media[]
  likes               Like[]
  bookmarks           Bookmark[]
  comments            Comment[]
  inlineComments      InlineComment[]
  tags                String[]        @default([])
  difficulty          Int             @default(1)
  codeBlocks          Int             @default(0)
  linkedNotifications Notification[]
  // ── 问答悬赏字段 ──
  isQuestion          Boolean         @default(false)
  bounty              Int             @default(0)
  isResolved          Boolean         @default(false)
  acceptedCommentId   String?         @unique
  acceptedComment     Comment?        @relation("AcceptedAnswer", fields: [acceptedCommentId], references: [id], onDelete: SetNull)
  viewCount           Int             @default(0)
  updateAt            DateTime        @default(now()) @updatedAt
  isJunk              Boolean         @default(false) // 垃圾内容标记
  clusterId           Int? // K-Means 簇编号

  createAt DateTime  @default(now())
  postTags PostTag[]

  @@map("posts")
}

model Media {
  id     String    @id @default(cuid())
  postId String?
  post   Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  type   MediaType
  url    String

  createAt DateTime @default(now())

  @@map("post_media")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id              String         @id @default(cuid())
  content         String
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  isAnswer        Boolean        @default(false)
  parentId        String?
  parent          Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]      @relation("CommentReplies")
  likes           CommentLike[]
  notifications   Notification[]
  // 反向关联：该评论被哪个帖子采纳为最佳答案
  acceptedForPost Post?          @relation("AcceptedAnswer")

  createAt DateTime @default(now())

  @@map("comments")
}

model InlineComment {
  id             String @id @default(cuid())
  content        String
  lineNumber     Int
  // 关联到哪个帖子
  postId         String
  post           Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 关联到第几个代码块（一个帖子可能有多段代码）
  codeBlockIndex Int    @default(0)
  // 评论者
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createAt DateTime @default(now())

  @@map("inline_comments")
}

model CommentLike {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model Like {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("bookmarks")
}

model AiConversation {
  id       String      @id @default(cuid())
  title    String      @default("新对话")
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String

  createAt DateTime @default(now())

  @@map("ai_messages")
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String   @default("easy")
  tags        String[] @default([])
  examples    Json     @default("[]")
  testCases   Json     @default("[]")
  starterCode Json     @default("{}")
  hints       String?
  order       Int      @default(0)

  submissions        QuizSubmission[]
  contestProblems    ContestProblem[]
  contestSubmissions ContestSubmission[]
  challenges         Challenge[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@map("quizzes")
}

model QuizSubmission {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId   String
  quiz     Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  code     String
  language String
  passed   Boolean @default(false)
  results  Json    @default("[]")

  createAt DateTime @default(now())

  @@map("quiz_submissions")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuerId    String
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type        NotificationType
  read        Boolean          @default(false)

  createAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  BOUNTY_ACCEPTED
}

model NotebookFolder {
  id        String     @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebooks Notebook[]
  order     Int        @default(0)

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("notebook_folders")
}

model PointTransaction {
  id     String               @id @default(cuid())
  userId String
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  type   PointTransactionType
  postId String?
  detail String?

  createAt DateTime @default(now())

  @@map("point_transactions")
}

enum PointTransactionType {
  INITIAL_BONUS
  BOUNTY_PLACED
  BOUNTY_EARNED
  BOUNTY_REFUND
  DAILY_SIGNIN
}

model Notebook {
  id       String          @id @default(cuid())
  title    String          @default("无标题笔记")
  content  String          @default("")
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId String?
  folder   NotebookFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags     String[]        @default([])
  pinned   Boolean         @default(false)

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@map("notebooks")
}

model Contest {
  id          String        @id @default(cuid())
  title       String
  description String        @default("")
  startTime   DateTime
  endTime     DateTime
  status      ContestStatus @default(UPCOMING)

  problems      ContestProblem[]
  registrations ContestRegistration[]
  submissions   ContestSubmission[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  @@map("contests")
}

enum ContestStatus {
  UPCOMING
  RUNNING
  ENDED
}

model ContestProblem {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  score     Int     @default(100)

  @@unique([contestId, quizId])
  @@map("contest_problems")
}

model ContestRegistration {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createAt DateTime @default(now())

  @@unique([contestId, userId])
  @@map("contest_registrations")
}

model ContestSubmission {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  code      String
  language  String
  passed    Boolean @default(false)
  penalty   Int     @default(0)
  time      Float?
  memory    Float?

  createAt DateTime @default(now())

  @@map("contest_submissions")
}

// ── 1v1 对战 ──

model Challenge {
  id           String          @id @default(cuid())
  difficulty   String          @default("EASY")
  quizId       String?
  quiz         Quiz?           @relation(fields: [quizId], references: [id], onDelete: SetNull)
  status       ChallengeStatus @default(MATCHING)
  timeLimit    Int             @default(900)
  challengerId String
  challenger   User            @relation("ChallengerUser", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String?
  opponent     User?           @relation("OpponentUser", fields: [opponentId], references: [id], onDelete: SetNull)
  winnerId     String?
  startedAt    DateTime?
  endedAt      DateTime?

  submissions ChallengeSubmission[]

  createAt DateTime @default(now())

  @@map("challenges")
}

enum ChallengeStatus {
  MATCHING
  ONGOING
  FINISHED
  CANCELLED
}

model ChallengeSubmission {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  language    String
  passed      Boolean   @default(false)
  time        Float?
  memory      Float?

  createAt DateTime @default(now())

  @@map("challenge_submissions")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique // "React", "数据库", "Docker" 等
  slug  String    @unique // "react", "database", "docker"
  posts PostTag[]

  createAt DateTime @default(now())

  @@map("tags")
}

model PostTag {
  id         String    @id @default(cuid())
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  confidence Float     @default(0) // 算法置信度 0~1
  source     TagSource @default(AUTO) // 来源

  createAt DateTime @default(now())
  user     User?    @relation(fields: [userId], references: [id])
  userId   String?

  @@unique([postId, tagId])
  @@map("post_tags")
}

enum TagSource {
  AUTO // 算法自动标注
  MANUAL // 用户手动添加
}
